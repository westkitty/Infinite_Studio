# Infinite Studio Companion Server Configuration
# Bind strictly to loopback by default. Never expose 0.0.0.0 without authenticated TLS.
INFINITE_COMPANION_HOST=127.0.0.1
INFINITE_COMPANION_PORT=8787
INFINITE_COMPANION_MODE=MOCK_DETERMINISTIC
INFINITE_COMPANION_AUTH_TOKEN=
INFINITE_COMPANION_MAX_PAYLOAD_BYTES=8388608
INFINITE_COMPANION_JOB_TTL_SECONDS=1800
# Optional remote upstream key (disabled unless INFINITE_COMPANION_MODE=REMOTE_OPENAI and userConfirmedPaidEgress=true)
OPENAI_API_KEY=
