{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infinite Studio Canon Passport v1 (portable untrusted claims)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "characterSheetId", "displayName", "references"],
  "properties": {
    "format": {"const": "infinite-studio-canon-passport"},
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "characterSheetId": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "references": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sha256"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mediaType": {"type": "string"}, "rightsNote": {"type": "string"},
        "provenanceLabel": {"type": "string"},
        "userSuppliedUriHint": {"type": ["string", "null"], "maxLength": 2048}
      }
    }},
    "locks": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "claim", "authorityNote"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["SILHOUETTE", "TOPOLOGY", "COLOR", "MARKING", "ANATOMY", "LITERAL", "PROHIBITION", "OTHER"]},
        "claim": {"type": "string", "minLength": 1},
        "authorityNote": {"type": "string", "minLength": 1},
        "requiresVisualReview": {"type": "boolean"}
      }
    }},
    "artistNotes": {"type": "string", "maxLength": 8000},
    "claimedApprovalState": {"type": "string"},
    "verifiedByCurrentUser": {"type": "boolean"}
  }
}
