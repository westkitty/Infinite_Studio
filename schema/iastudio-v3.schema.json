{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinitestudio.local/schema/iastudio-v3.schema.json",
  "title": "Infinite Studio Canonical v3 Archive Manifest",
  "description": "Schema for manifest.json inside a .iastudio v3 ZIP archive (matches DocumentArchiveCodec.ArchiveManifest).",
  "type": "object",
  "required": ["format", "schemaVersion", "document"],
  "properties": {
    "format": {
      "const": "infinite-studio-archive"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "document": {
      "type": "object",
      "required": ["documentId", "revision", "title", "bounds", "tileSize", "paperColorHex", "layers"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "bounds": {
          "type": "object",
          "required": ["minX", "minY", "width", "height", "units"],
          "properties": {
            "minX": { "type": "number" },
            "minY": { "type": "number" },
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "units": { "type": "string" }
          }
        },
        "tileSize": { "type": "integer", "enum": [256] },
        "paperColorHex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6,8}$" },
        "activeLayerId": { "type": ["string", "null"] },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "name", "visible", "opacity", "blendModeId", "alphaLock", "tileKeys"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "visible": { "type": "boolean" },
              "opacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "blendModeId": { "type": "string" },
              "alphaLock": { "type": "boolean" },
              "transform": {
                "type": "object",
                "properties": {
                  "offsetX": { "type": "number" },
                  "offsetY": { "type": "number" },
                  "scaleX": { "type": "number" },
                  "scaleY": { "type": "number" },
                  "rotationDeg": { "type": "number" }
                }
              },
              "depthPlaneId": { "type": ["string", "null"] },
              "tileKeys": {
                "type": "array",
                "items": { "type": "string", "pattern": "^-?[0-9]+_-?[0-9]+$" }
              }
            }
          }
        },
        "vectorObjects": { "type": "array" },
        "masks": { "type": "array" },
        "semanticObjects": { "type": "array" },
        "constraints": { "type": "array" },
        "materials": { "type": "array" },
        "spatialStage": { "type": "object" },
        "timeline": { "type": "object" },
        "recipes": { "type": "array" },
        "vaultAssets": { "type": "array" },
        "characterSheets": { "type": "array" },
        "guidanceMarks": { "type": "array" },
        "customPresets": { "type": "array" },
        "branches": { "type": "array" },
        "activeBranchId": { "type": "string" },
        "revisions": { "type": "array" },
        "artDirectorHistory": { "type": "array" }
      }
    },
    "assetChecksums": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "unknownFields": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
